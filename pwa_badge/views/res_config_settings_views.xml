<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="res_config_settings_view_form_pwa_badge" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.pwa.badge</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <block id="pwa_settings" position="attributes">
                <attribute name="groups"/>
            </block>
            <block id="pwa_settings" position="inside">
                <setting string="Badge de la app instalada">
                    <field name="pwa_badge_count_mode" />
                    <div class="text-muted mt-2">
                        El badge puede mostrar actividades pendientes, notificaciones de mail o ambas.
                    </div>
                </setting>
                <setting string="Comportamiento Android">
                    <field name="pwa_badge_android_mode" />
                    <div class="text-muted mt-2">
                        En Android el badge del launcher depende del navegador y del launcher. El modo de notificaciones del sistema mejora la compatibilidad.
                    </div>
                </setting>
                <setting string="Fallback visual">
                    <field name="pwa_badge_enable_title_fallback" />
                    <div class="text-muted mt-2">
                        Si el navegador no soporta la Badging API, el contador se reflejara en el titulo de la pestaña.
                    </div>
                </setting>
                <setting string="Permiso de notificaciones">
                    <div class="mt-2">
                        <button
                            name="pwa_badge_request_permission"
                            type="button"
                            class="btn btn-secondary"
                            data-pwa-badge-request-permission="1"
                        >
                            Solicitar permiso del navegador
                        </button>
                    </div>
                    <div class="text-muted mt-2">
                        Usa este boton desde el navegador donde se instalara la PWA.
                    </div>
                </setting>
            </block>
        </field>
    </record>
</odoo>
