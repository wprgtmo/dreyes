<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="group_clover_operator" model="res.groups">
        <field name="name">Operador Clover</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="group_clover_manager" model="res.groups">
        <field name="name">Administrador Clover</field>
        <field name="implied_ids" eval="[(4, ref('dreyes_clover_sync.group_clover_operator'))]"/>
    </record>

    <record id="rule_clover_connector_company" model="ir.rule">
        <field name="name">Conexiones Clover por empresa</field>
        <field name="model_id" ref="model_clover_connector"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('dreyes_clover_sync.group_clover_operator'))]"/>
    </record>
    <record id="rule_clover_event_company" model="ir.rule">
        <field name="name">Eventos Clover por empresa</field>
        <field name="model_id" ref="model_clover_sync_event"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('dreyes_clover_sync.group_clover_operator'))]"/>
    </record>
    <record id="rule_clover_map_company" model="ir.rule">
        <field name="name">Mapeos Clover por empresa</field>
        <field name="model_id" ref="model_clover_object_map"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('dreyes_clover_sync.group_clover_operator'))]"/>
    </record>
    <record id="rule_clover_binding_company" model="ir.rule">
        <field name="name">Productos Clover por empresa</field>
        <field name="model_id" ref="model_clover_product_binding"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('dreyes_clover_sync.group_clover_operator'))]"/>
    </record>
    <record id="rule_clover_tender_company" model="ir.rule">
        <field name="name">Tenders Clover por empresa</field>
        <field name="model_id" ref="model_clover_tender_map"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('dreyes_clover_sync.group_clover_operator'))]"/>
    </record>
    <record id="rule_clover_conflict_company" model="ir.rule">
        <field name="name">Conflictos Clover por empresa</field>
        <field name="model_id" ref="model_clover_sync_conflict"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('dreyes_clover_sync.group_clover_operator'))]"/>
    </record>
</odoo>
