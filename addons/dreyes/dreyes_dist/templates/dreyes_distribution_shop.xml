<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="distribution_shop_products" inherit_id="website_sale.products_item" name="Precios protegidos de distribución">
        <xpath expr="//div[hasclass('product_price')]" position="attributes">
            <attribute name="t-if">not website._dreyes_is_distribution_site() or website._dreyes_can_purchase()</attribute>
        </xpath>
        <xpath expr="//div[hasclass('product_price')]" position="after">
            <span t-if="website._dreyes_is_distribution_site() and not website._dreyes_can_purchase()" class="text-muted fw-semibold">Precio disponible al aprobar la cuenta</span>
        </xpath>
        <xpath expr="//div[hasclass('o_wsale_product_btn')]" position="attributes">
            <attribute name="t-if">not website._dreyes_is_distribution_site() or website._dreyes_can_purchase()</attribute>
        </xpath>
    </template>

    <template id="distribution_product_price" inherit_id="website_sale.product_price" name="Mensaje de precio protegido">
        <xpath expr="//div[@id='product_unavailable']/h3" position="replace">
            <h3 t-if="website._dreyes_is_distribution_site() and not website._dreyes_can_purchase()" class="fst-italic">Precio disponible al aprobar la cuenta</h3>
            <h3 t-else="" class="fst-italic" t-field="website.prevent_zero_price_sale_text"/>
        </xpath>
    </template>

    <template id="distribution_pricelist_dropdown" inherit_id="website_sale.pricelist_list" name="Ocultar selector de lista">
        <xpath expr="//div[contains(@t-attf-class, 'o_pricelist_dropdown')]" position="attributes">
            <attribute name="t-if">not website._dreyes_is_distribution_site()</attribute>
        </xpath>
    </template>

    <template id="distribution_cart_link" inherit_id="website_sale.header_cart_link" name="Ocultar carrito sin aprobación">
        <xpath expr="//li[contains(@t-attf-class, 'o_wsale_my_cart')]" position="attributes">
            <attribute name="t-if">not website._dreyes_is_distribution_site() or website._dreyes_can_purchase()</attribute>
        </xpath>
    </template>
</odoo>
