<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="portal_distributor_profile" name="Perfil de distribuidor">
        <t t-call="portal.portal_layout">
            <div class="container py-4 sd_profile_page">
                <div class="sd_profile_form_shell mx-auto">
                    <div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-3">
                        <div>
                            <h1 class="sd_profile_title mb-1">Perfil de distribuidor</h1>
                            <p class="sd_profile_subtitle mb-0">Puede guardar un borrador y completar la información cuando desee.</p>
                        </div>
                        <span t-attf-class="badge rounded-pill px-3 py-2 #{'text-bg-success' if profile_state == 'approved' else 'text-bg-warning' if profile_state in ('under_review', 'pending_approval') else 'text-bg-secondary'}">
                            <t t-esc="profile_state_label"/>
                        </span>
                    </div>

                    <div t-if="profile.correction_reason" class="alert alert-warning">
                        <strong>Correcciones solicitadas:</strong>
                        <span t-esc="profile.correction_reason"/>
                    </div>
                    <div t-if="saved" class="alert alert-success">Los cambios fueron guardados.</div>
                    <div t-if="error" class="alert alert-danger" role="alert"><t t-esc="error"/></div>

                    <form class="sd_profile_form" method="post" enctype="multipart/form-data">
                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                        <h4 class="mt-3">Información comercial</h4>
                        <div class="row g-3">
                            <div class="col-12">
                                <label for="legal_business_name" class="form-label fw-bold">Nombre legal de la empresa</label>
                                <input id="legal_business_name" name="legal_business_name" class="form-control sd_input" t-att-value="legal_business_name"/>
                            </div>
                            <div class="col-md-6">
                                <label for="ein" class="form-label fw-bold">EIN</label>
                                <input id="ein" name="ein" class="form-control sd_input" inputmode="numeric" placeholder="XX-XXXXXXX"/>
                                <small t-if="ein_masked" class="text-muted">Guardado: <t t-esc="ein_masked"/>. Déjelo vacío para conservarlo.</small>
                            </div>
                            <div class="col-md-6">
                                <label for="tax_permit_number" class="form-label fw-bold">Número del permiso de Texas</label>
                                <input id="tax_permit_number" name="tax_permit_number" class="form-control sd_input" inputmode="numeric" t-att-value="tax_permit_number"/>
                            </div>
                            <div class="col-md-6">
                                <label for="first_name" class="form-label fw-bold">Nombre del contacto</label>
                                <input id="first_name" name="first_name" class="form-control sd_input" t-att-value="first_name"/>
                            </div>
                            <div class="col-md-6">
                                <label for="last_name" class="form-label fw-bold">Apellido del contacto</label>
                                <input id="last_name" name="last_name" class="form-control sd_input" t-att-value="last_name"/>
                            </div>
                            <div class="col-12">
                                <label for="email" class="form-label fw-bold">Correo electrónico</label>
                                <input id="email" type="email" name="email" class="form-control sd_input" t-att-value="email"/>
                            </div>
                        </div>

                        <h4 class="mt-4">Dirección y teléfono</h4>
                        <div class="row g-3">
                            <div class="col-12"><label for="street" class="form-label fw-bold">Dirección</label><input id="street" name="street" class="form-control sd_input" t-att-value="street"/></div>
                            <div class="col-12"><label for="street2" class="form-label fw-bold">Dirección, línea 2</label><input id="street2" name="street2" class="form-control sd_input" t-att-value="street2"/></div>
                            <div class="col-md-6"><label for="city" class="form-label fw-bold">Ciudad</label><input id="city" name="city" class="form-control sd_input" t-att-value="city"/></div>
                            <div class="col-md-6">
                                <label for="state_id" class="form-label fw-bold">Estado</label>
                                <select id="state_id" name="state_id" class="form-select sd_input">
                                    <option value=""/>
                                    <option t-foreach="states" t-as="state" t-att-value="state.id" t-att-selected="str(state.id) == state_id"><t t-esc="state.name"/> <t t-if="state.country_id">(<t t-esc="state.country_id.code"/>)</t></option>
                                </select>
                            </div>
                            <div class="col-md-6"><label for="zip" class="form-label fw-bold">Código postal</label><input id="zip" name="zip" class="form-control sd_input" t-att-value="zip"/></div>
                            <div class="col-md-6">
                                <label for="country_id" class="form-label fw-bold">País</label>
                                <select id="country_id" name="country_id" class="form-select sd_input">
                                    <option value=""/>
                                    <option t-foreach="countries" t-as="country" t-att-value="country.id" t-att-selected="str(country.id) == country_id"><t t-esc="country.name"/></option>
                                </select>
                            </div>
                            <div class="col-md-4">
                                <label for="phone_code" class="form-label fw-bold">Código</label>
                                <select id="phone_code" name="phone_code" class="form-select sd_input">
                                    <option t-foreach="phone_countries" t-as="phone_country" t-att-value="phone_country.phone_code" t-att-selected="str(phone_country.phone_code) == (phone_code or '1')"><t t-esc="phone_country.code"/> +<t t-esc="phone_country.phone_code"/></option>
                                </select>
                            </div>
                            <div class="col-md-8"><label for="phone" class="form-label fw-bold">Teléfono</label><input id="phone" type="tel" name="phone" class="form-control sd_input" t-att-value="phone"/></div>
                        </div>

                        <h4 class="mt-4">Tax permit</h4>
                        <div class="mb-3">
                            <label for="tax_permit" class="form-label fw-bold">Archivo PDF, JPG o PNG</label>
                            <input id="tax_permit" type="file" name="tax_permit" class="form-control" accept=".pdf,.jpg,.jpeg,.png"/>
                            <small class="text-muted">Máximo 15 MB. Cargar un archivo nuevo conserva las versiones anteriores.</small>
                        </div>
                        <div t-if="profile.permit_ids" class="list-group mb-3">
                            <a t-foreach="profile.permit_ids" t-as="permit" t-att-href="'/my/distributor-profile/permit/%s' % permit.id" class="list-group-item list-group-item-action d-flex justify-content-between">
                                <span><i class="fa fa-file-o me-2"/><t t-esc="permit.filename"/></span>
                                <small t-field="permit.uploaded_at" t-options='{"widget": "datetime"}'/>
                            </a>
                        </div>
                        <div class="form-check mb-4">
                            <input id="join_community" type="checkbox" name="join_community" value="1" class="form-check-input" t-att-checked="join_community"/>
                            <label for="join_community" class="form-check-label">Deseo unirme a la comunidad</label>
                        </div>

                        <div class="d-flex flex-wrap gap-2">
                            <button type="submit" name="action" value="save" class="btn btn-outline-primary">Guardar borrador</button>
                            <button type="submit" name="action" value="submit" class="btn btn-primary">Enviar a revisión</button>
                            <button t-if="profile_state == 'no_profile'" type="submit" name="action" value="later" class="btn btn-link ms-auto">Completar después</button>
                        </div>
                    </form>
                </div>
            </div>
        </t>
    </template>

    <template id="distribution_profile_dropdown" inherit_id="portal.user_dropdown" name="Perfil distribuidor en menú">
        <xpath expr="//div[@id='o_logout_divider']" position="before">
            <a t-if="request.website and request.website._dreyes_is_distribution_site()" href="/my/distributor-profile" role="menuitem" class="dropdown-item ps-3">
                <t t-set="menu_profile" t-value="request.website._dreyes_current_profile(create=True)"/>
                <i class="fa fa-fw fa-building-o me-1 small text-primary"/> Perfil de distribuidor
                <span class="badge text-bg-secondary ms-1"><t t-esc="dict(menu_profile._fields['state'].selection).get(menu_profile.state)"/></span>
            </a>
        </xpath>
    </template>

    <template id="distribution_profile_portal_card" inherit_id="portal.portal_my_home" name="Estado del distribuidor">
        <xpath expr="//div[@id='oe_structure_portal_my_home_1']" position="after">
            <t t-if="request.website._dreyes_is_distribution_site()">
                <t t-set="dist_profile" t-value="request.website._dreyes_current_profile(create=True)"/>
                <div class="card my-3 border-primary">
                    <div class="card-body d-flex flex-wrap justify-content-between align-items-center gap-3">
                        <div>
                            <div class="text-muted small text-uppercase">Cuenta de distribución</div>
                            <h3 class="mb-1"><t t-esc="dict(dist_profile._fields['state'].selection).get(dist_profile.state)"/></h3>
                            <p class="mb-0" t-if="not dist_profile.can_purchase">Los precios y las compras se habilitarán cuando su cuenta sea aprobada.</p>
                            <p class="mb-0" t-else="">Su cuenta está habilitada para comprar.</p>
                        </div>
                        <a href="/my/distributor-profile" class="btn btn-primary">Ver perfil</a>
                    </div>
                </div>
            </t>
        </xpath>
    </template>
</odoo>
