<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="group_distribution_reviewer" model="res.groups">
        <field name="name">Revisor de distribución</field>
        <field name="category_id" ref="base.module_category_sales_sales"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="base.group_system" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_distribution_reviewer'))]"/>
    </record>
    <record id="rule_distribution_segment_company" model="ir.rule">
        <field name="name">Segmentos de distribución por compañía</field>
        <field name="model_id" ref="model_dreyes_market_segment"/>
        <field name="groups" eval="[(4, ref('group_distribution_reviewer'))]"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_distribution_profile_company" model="ir.rule">
        <field name="name">Expedientes de distribución por compañía</field>
        <field name="model_id" ref="model_dreyes_distributor_profile"/>
        <field name="groups" eval="[(4, ref('group_distribution_reviewer'))]"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_distribution_permit_company" model="ir.rule">
        <field name="name">Permisos de distribución por compañía</field>
        <field name="model_id" ref="model_dreyes_distributor_permit"/>
        <field name="groups" eval="[(4, ref('group_distribution_reviewer'))]"/>
        <field name="domain_force">[('profile_id.company_id', 'in', company_ids)]</field>
    </record>
</odoo>
