<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_dreyes_market_segment_list" model="ir.ui.view">
        <field name="name">dreyes.market.segment.list</field>
        <field name="model">dreyes.market.segment</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/><field name="company_id" groups="base.group_multi_company"/>
                <field name="pricelist_id"/><field name="approved_profile_count"/><field name="active"/>
            </list>
        </field>
    </record>
    <record id="view_dreyes_market_segment_form" model="ir.ui.view">
        <field name="name">dreyes.market.segment.form</field>
        <field name="model">dreyes.market.segment</field>
        <field name="arch" type="xml">
            <form><sheet><group><field name="name"/><field name="company_id" groups="base.group_multi_company"/><field name="pricelist_id"/><field name="active"/></group></sheet></form>
        </field>
    </record>
    <record id="action_dreyes_market_segments" model="ir.actions.act_window">
        <field name="name">Segmentos de mercado</field><field name="res_model">dreyes.market.segment</field><field name="view_mode">list,form</field>
    </record>

    <record id="view_dreyes_distributor_profile_list" model="ir.ui.view">
        <field name="name">dreyes.distributor.profile.list</field>
        <field name="model">dreyes.distributor.profile</field>
        <field name="arch" type="xml">
            <list decoration-success="state == 'approved'" decoration-warning="state in ('under_review', 'pending_approval')">
                <field name="legal_business_name"/><field name="partner_id"/><field name="company_id" groups="base.group_multi_company"/>
                <field name="state" widget="badge"/><field name="segment_id"/><field name="submitted_at"/>
            </list>
        </field>
    </record>
    <record id="view_dreyes_distributor_profile_form" model="ir.ui.view">
        <field name="name">dreyes.distributor.profile.form</field>
        <field name="model">dreyes.distributor.profile</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_mark_reviewed" type="object" string="Marcar revisado" class="btn-primary" invisible="state != 'under_review'"/>
                    <button name="action_approve" type="object" string="Aprobar" class="btn-primary" invisible="state != 'pending_approval'"/>
                    <button name="action_request_corrections" type="object" string="Solicitar correcciones" invisible="state not in ('under_review', 'pending_approval', 'approved')" confirm="Se suspenderá el acceso de compra del cliente."/>
                    <field name="state" widget="statusbar" statusbar_visible="no_profile,under_review,pending_approval,approved"/>
                </header>
                <sheet>
                    <group>
                        <group><field name="legal_business_name"/><field name="partner_id"/><field name="company_id" groups="base.group_multi_company"/><field name="website_id"/></group>
                        <group><field name="segment_id"/><field name="is_complete" readonly="1"/><field name="can_purchase" readonly="1"/></group>
                    </group>
                    <group string="Información fiscal"><field name="ein"/><field name="tax_permit_number"/><field name="current_permit_id" readonly="1"/></group>
                    <group string="Correcciones"><field name="correction_reason" placeholder="Obligatorio antes de solicitar correcciones"/></group>
                    <notebook>
                        <page string="Historial de permisos"><field name="permit_ids" readonly="1"><list><field name="filename"/><field name="mimetype"/><field name="uploaded_at"/><field name="uploaded_by_id"/></list></field></page>
                        <page string="Auditoría"><group><field name="submitted_at"/><field name="submitted_by_id"/><field name="reviewed_at"/><field name="reviewed_by_id"/><field name="approved_at"/><field name="approved_by_id"/></group></page>
                        <page string="Seguimiento"><field name="message_follower_ids"/><field name="activity_ids"/><field name="message_ids"/></page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_dreyes_distributor_profiles" model="ir.actions.act_window">
        <field name="name">Expedientes de distribuidores</field><field name="res_model">dreyes.distributor.profile</field><field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_dreyes_distribution" name="Distribución" parent="contacts.menu_contacts" sequence="60" groups="dreyes_dist.group_distribution_reviewer"/>
    <menuitem id="menu_dreyes_distributor_profiles" name="Expedientes" parent="menu_dreyes_distribution" action="action_dreyes_distributor_profiles" sequence="10"/>
    <menuitem id="menu_dreyes_market_segments" name="Segmentos de mercado" parent="menu_dreyes_distribution" action="action_dreyes_market_segments" sequence="20"/>
</odoo>
